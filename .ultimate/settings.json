{
  "isolates": {
    "worktree": {
      "setup": ["sh -e .ultimate/worktree-setup.sh"]
    }
  },
  "lander": {
    "checks": [
      [
        { "command": "node --test $(find . -name '*.test.ts' -not -path '*/node_modules/*')", "timeout": 300 },
        { "command": "sh typecheck.sh", "timeout": 300 }
      ]
    ],
    "push": "origin"
  }
}
